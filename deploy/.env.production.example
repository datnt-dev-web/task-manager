# Sao chép thành deploy/.env.production trên máy chủ rồi điền giá trị. KHÔNG commit file thật.

# Mật khẩu PostgreSQL (chuỗi ngẫu nhiên dài): openssl rand -hex 24
POSTGRES_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

CLIENT_URL=https://beta.hopphu.vn
APP_URL=https://beta.hopphu.vn

# Google OAuth Client ID (dùng cho cả API và bản build web)
GOOGLE_CLIENT_ID=

# Quản trị viên đầu tiên — đăng nhập Google bằng đúng email này
INITIAL_ADMIN_EMAIL=
# Đặt thì API luôn giữ tài khoản trên là Quản trị viên với đúng mật khẩu này. Dùng mật khẩu mạnh!
INITIAL_ADMIN_PASSWORD=

# Email thông báo (ví dụ Gmail SMTP với App Password, hoặc dịch vụ SMTP của công ty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Task Manager <no-reply@hopphu.vn>

MAX_UPLOAD_MB=10
ENABLE_JOBS=true
