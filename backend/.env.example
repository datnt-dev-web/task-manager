NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5434/taskmanager
CLIENT_URL=http://localhost:5173

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Email quản trị viên đầu tiên (dùng cho seeder)
INITIAL_ADMIN_EMAIL=
# Đặt thì API luôn giữ tài khoản trên là Quản trị viên với đúng mật khẩu này (đăng nhập bằng email + mật khẩu)
INITIAL_ADMIN_PASSWORD=

# Chỉ dùng khi phát triển: đăng nhập bằng email không cần Google. KHÔNG bật ở production.
ALLOW_DEV_LOGIN=true

# Link trong email
APP_URL=http://localhost:5173

# Tệp đính kèm
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Email thông báo — bỏ trống SMTP_HOST thì chỉ ghi log ra console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Task Manager <no-reply@hopphu.vn>

# Nhắc hạn lúc 8:00 hằng ngày (giờ Việt Nam)
ENABLE_JOBS=true
